<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lyrics Helper</title>
  <link rel="stylesheet" href="/style.css?v=99" />
</head>
<body>
  <div class="app-shell">
    <header class="topbar">
      <div class="brand-block">
        <p class="eyebrow">Lyrics workspace</p>
        <h1>Lyrics Helper</h1>
      </div>

      <div class="topbar-actions">
        <p class="welcome-line">Welcome, <%= username %></p>
        <p class="version-pill"><%= pageVersion %></p>
        <form action="/logout" method="POST">
          <button type="submit" class="ghost-btn small-btn">Logout</button>
        </form>
      </div>
    </header>

    <main
      class="workspace-layout"
      id="workspaceLayout"
      style="--panel-width: 360px; --rail-width: <%= railWidth || '72px' %>;"
    >
    -- 
      <section class="panel panel-editor">
        <div class="editor-top-strip">
          <div class="field-group title-field">
            <label for="songTitle">Song title</label>
            <input
              type="text"
              id="songTitle"
              placeholder="Enter a title"   
              maxlength="255"
            />
          </div>

          <div class="main-action-bar">
            <button id="openLibraryBtn" type="button" class="ghost-btn action-btn-main">Open</button>
            <button id="analyzeBtn" type="button" class="primary-btn action-btn-main">Analyze</button>
            <button id="saveSongBtn" type="button" class="accent-btn action-btn-main">Save</button>
            <button id="newSongBtn" type="button" class="secondary-btn action-btn-main">New</button>
          </div>
        </div>

        <div class="editor-main-grid" id="editorMainGrid">
          <section class="section-builder-card sections-panel compact-builder-card" id="sectionsPanel">
            <button
              type="button"
              class="sections-toggle"
              id="sectionsToggle"
              aria-expanded="true"
              aria-controls="sectionsPanelBody"
            >
              <div class="sections-toggle-copy">
                <p class="panel-kicker">Sections</p>
                <h2>Structure</h2>
                <p class="builder-copy">Add sections, drag them into order, and keep the full draft synced below.</p>
              </div>

              <span class="sections-summary-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 8l4 4 4-4"></path>
                </svg>
              </span>
            </button>

            <div class="sections-panel-body" id="sectionsPanelBody">
              <div class="section-type-row compact-type-row">
                <button type="button" class="secondary-btn small-btn add-section-btn" data-type="Verse">+ Verse</button>
                <button type="button" class="secondary-btn small-btn add-section-btn" data-type="Pre-Chorus">+ Pre-Chorus</button>
                <button type="button" class="secondary-btn small-btn add-section-btn" data-type="Chorus">+ Chorus</button>
                <button type="button" class="secondary-btn small-btn add-section-btn" data-type="Bridge">+ Bridge</button>
                <button type="button" class="secondary-btn small-btn add-section-btn" data-type="Hook">+ Hook</button>
                <button type="button" class="secondary-btn small-btn add-section-btn" data-type="Intro">+ Intro</button>
                <button type="button" class="secondary-btn small-btn add-section-btn" data-type="Outro">+ Outro</button>
              </div>

              <div id="sectionsList" class="sections-list sections-list-compact"></div>

              <div id="sectionsEmptyState" class="sections-empty-state">
                <p class="empty-copy">No sections yet. Start with a Verse or Chorus.</p>
              </div>
            </div>
          </section>

          <section class="lyrics-panel">
            <div class="lyrics-panel-head">
              <div>
                <p class="panel-kicker">Draft</p>
                <h2>Lyrics editor</h2>
              </div>
              <p id="saveStatus" class="status-line" aria-live="polite"></p>
            </div>

            <div class="field-group editor-lyrics-group compact-lyrics-group">
              <label for="lyricsInput">Full lyrics</label>
              <textarea
                id="lyricsInput"
                placeholder="Write your lyrics here, or build them from sections above..."
                rows="16"
              ></textarea>
            </div>
          </section>
        </div>
      </section>

      <div
        id="panelResizeHandle"
        class="panel-resizer"
        role="separator"
        aria-label="Resize side panel"
        aria-orientation="vertical"
      >
        <span class="panel-resizer-grip"></span>
      </div>

      <div class="side-shell">
        <div class="side-tab-rail" role="tablist" aria-label="Workspace panels">
          <button
            id="tab-library"
            class="side-tab is-active"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-library"
            data-panel="library"
            tabindex="0"
          >
            <span class="side-tab-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H20v15.5A1.5 1.5 0 0 0 18.5 18H6.5A2.5 2.5 0 0 0 4 20.5z"></path>
                <path d="M8 8h8"></path>
                <path d="M8 12h8"></path>
              </svg>
            </span>
            <span class="side-tab-text">Library</span>
          </button>

          <button
            id="tab-analysis"
            class="side-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-analysis"
            data-panel="analysis"
            tabindex="-1"
          >
            <span class="side-tab-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19h16"></path>
                <path d="M7 16V9"></path>
                <path d="M12 16V5"></path>
                <path d="M17 16v-4"></path>
              </svg>
            </span>
            <span class="side-tab-text">Analysis</span>
          </button>

          <button
            id="tab-tools"
            class="side-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-tools"
            data-panel="tools"
            tabindex="-1"
          >
            <span class="side-tab-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 1 1.4 0l1.6 1.6a1 1 0 0 1 0 1.4l-7.8 7.8-3.3.6.6-3.3z"></path>
                <path d="M13.5 7.5l3 3"></path>
                <path d="M5 21h14"></path>
              </svg>
            </span>
            <span class="side-tab-text">Tools</span>
          </button>
        </div>

        <aside class="side-panel panel" id="sidePanel" aria-label="Workspace panels">
          <div class="side-panel-topbar">
            <p id="activePanelLabel" class="side-panel-label">Library panel</p>
            <button id="collapsePanelBtn" type="button" class="ghost-btn small-btn">Collapse</button>
          </div>

          <div class="side-panel-body">
            <section
              id="panel-library"
              class="side-panel-view is-active"
              role="tabpanel"
              aria-labelledby="tab-library"
              tabindex="0"
            >
              <div class="drawer-panel-header">
                <div>
                  <p class="panel-kicker">Library</p>
                  <h2>My songs</h2>
                </div>
              </div>
              <p class="drawer-copy">Load, update, and remove saved songs.</p>
              <div id="songsList" class="songs-list">
                <p class="empty-copy">Loading songs...</p>
              </div>
            </section>

            <section
              id="panel-analysis"
              class="side-panel-view"
              role="tabpanel"
              aria-labelledby="tab-analysis"
              tabindex="0"
              hidden
            >
              <div class="drawer-panel-header">
                <div>
                  <p class="panel-kicker">Analysis</p>
                  <h2>Song insights</h2>
                </div>
              </div>
              <p class="drawer-copy">View structure and word-count analysis for the current draft.</p>
              <div id="analysisResults" class="analysis-results">
                <p class="empty-copy">No analysis yet.</p>
              </div>
            </section>

            <section
              id="panel-tools"
              class="side-panel-view"
              role="tabpanel"
              aria-labelledby="tab-tools"
              tabindex="0"
              hidden
            >
              <div class="drawer-panel-header">
                <div>
                  <p class="panel-kicker">Tools</p>
                  <h2>Writing aids</h2>
                </div>
              </div>
              <p class="drawer-copy">Use rhymes and prompts without crowding the editor.</p>

              <div class="tools-panel-body">
                <div class="tool-section">
                  <p class="tool-section-label">Writing prompts</p>
                  <div class="tool-row tool-row-drawer">
                    <button id="rhymingBtn" type="button" class="secondary-btn tool-btn">Rhyming</button>
                    <button id="randomBtn" type="button" class="secondary-btn tool-btn">Random</button>
                  </div>
                </div>

                <div id="toolResults" class="tool-results" hidden>
                  <div class="tool-results-head">
                    <h3 id="toolResultsTitle">Writing tools</h3>
                    <button id="closeToolResultsBtn" type="button" class="ghost-btn small-btn">Close</button>
                  </div>
                  <div id="toolResultsBody" class="tool-results-body"></div>
                </div>

                <div id="toolEmptyState" class="tool-empty-state">
                  <p class="empty-copy">Select a word in the editor, then use Rhyming to fetch rhyme matches. Click a result to insert it into your lyrics.</p>
                </div>
              </div>
            </section>
          </div>
        </aside>
      </div>
    </main>
  </div>

</body>
</html>
